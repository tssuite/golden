{
  "name": "@tssuite/golden",
  "version": "1.0.0",
  "description": "Create golden files right within your tests",
  "homepage": "https://github.com/tssuite/golden",
  "bugs": "https://github.com/tssuite/golden/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/golden.git"
  },
  "main": "dist/golden.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && tsc && node dna/scripts/copy-readme-to-dist.js",
    "test": "vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@rljson/json": "^0.0.23",
    "@tssuite/dna-tssuite": "^0.1.1",
    "@tssuite/helix-js": "^0.1.0",
    "@tssuite/project-root": "0.0.17",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.11.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "peerDependencies": {
    "@rljson/json": "^0.0.21",
    "@tssuite/project-root": "0.0.17"
  }
}